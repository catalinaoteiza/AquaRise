# AquaRise Discovery Environment Configuration
# Development toggle for fallback demo discovery data (safe for client)
VITE_USE_DEMO_DISCOVERY_DATA=true

# Server-Side Private Search API Keys (DO NOT PREFIX WITH VITE_)
# These secrets MUST stay on the server and be accessed via protected API routes (e.g. /api/discovery/search)
# TAVILY_API_KEY=your_tavily_api_key_here
# SERPER_API_KEY=your_serper_api_key_here
